MEMORY_LLM_PROVIDER=openai
MEMORY_LLM_MODEL=google/gemma-4-26b-a4b-it:free
MEMORY_LLM_API_KEY=<unified key>
MEMORY_LLM_BASE_URL=http://127.0.0.1:3001/v1
MEMORY_LLM_MAX_TOKENS=600
MEMORY_EMBEDDER_BASE_URL=http://127.0.0.1:7997/v1
MEMORY_EMBEDDER_API_KEY=local
MEMORY_EMBEDDER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_EMBEDDING_DIMS=384
MEMORY_PERSIST_DIR=/root/.openclaw/workspace/hymemory-data/vector_db
